APP_PORT=8000

POSTGRES_DB=meeting_room_booking
POSTGRES_HOST_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=change_me

# JWT secret must be at least 32 bytes
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
# Token lifetime in milliseconds (86400000 = 24h)
JWT_EXPIRATION=86400000
# First admin account, created on startup if ADMIN_PASSWORD is set
ADMIN_EMAIL=admin@meetingroom.local
ADMIN_PASSWORD=Change_me_123!

# Refresh token lifetime in milliseconds (604800000 = 7 days)
JWT_REFRESH_EXPIRATION=604800000
